{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/chat",   "dest": "/api/index.py" },
    { "src": "/api/health", "dest": "/api/index.py" },
    { "src": "/(.*)",       "dest": "/$1" }
  ]
}
